{
  "name": "jest-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "yarn fetchSupporters && docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "crowdin:download": "echo 'Downloading translations from Crowdin' && crowdin download --config ../crowdin.yaml --language ja --language es-ES --language fr --language pt-BR --language ro --language ru --language uk --language zh-CN",
    "crowdin:upload": "echo 'Uploading sources to Crowdin' && crowdin upload sources --config ../crowdin.yaml",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "fetchSupporters": "node fetchSupporters.js",
    "netlify:ci:production": "yarn netlify:prepare && yarn netlify:crowdin && yarn build",
    "netlify:ci:deployPreview": "yarn netlify:prepare && yarn build -l en",
    "netlify:prepare": "yarn fetchSupporters",
    "netlify:crowdin": "yarn write-translations && yarn crowdin:upload && yarn crowdin:download",
    "typecheck": "tsc"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/plugin-client-redirects": "^3.0.0",
    "@docusaurus/plugin-pwa": "^3.0.0",
    "@docusaurus/preset-classic": "^3.0.0",
    "@docusaurus/remark-plugin-npm2yarn": "^3.0.0",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-remark-plugin-tab-blocks": "^4.0.0",
    "prism-react-renderer": "^2.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-github-btn": "^1.4.0",
    "react-lite-youtube-embed": "^3.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@crowdin/cli": "^4.7.0",
    "@docusaurus/module-type-aliases": "^3.0.0",
    "@docusaurus/tsconfig": "^3.0.0",
    "@types/react": "^18.3.23",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "js-yaml": "^4.1.1",
    "netlify-plugin-cache": "^1.0.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "yarn@4.18.0",
  "prettier": {
    "bracketSpacing": false,
    "proseWrap": "never",
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "overrides": [
      {
        "files": "**/*.js",
        "options": {
          "trailingComma": "es5"
        }
      },
      {
        "files": [
          "sidebars.json",
          "versioned_sidebars/*.json"
        ],
        "options": {
          "parser": "json-stringify"
        }
      },
      {
        "files": "versioned_docs/*/*.md",
        "options": {
          "parser": "mdx"
        }
      }
    ]
  }
}
